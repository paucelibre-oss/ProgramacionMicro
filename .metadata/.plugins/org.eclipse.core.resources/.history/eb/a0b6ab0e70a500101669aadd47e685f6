#include "spi.h"

SPI_HandleTypeDef hspi1;

static volatile bool txCompleteSPI = false;
static volatile bool rxCompleteSPI= false;
static volatile uint32_t spi_last_error = HAL_OK;

/* helpers */
void clearFlagTxSPI(void){ txCompleteSPI = false; }
void clearFlagRxSPI(void){ rxCompleteSPI = false; }
bool getRxFlagStatus(void){ return rxCompleteSPI; }
bool getTxFlagStatus(void){ return txCompleteSPI; }
uint32_t getSPILastError(void){ return spi_last_error; }

void HAL_SPI_TxCpltCallback(SPI_HandleTypeDef *hspi){
    if(hspi->Instance == SPI1){
    	txCompleteSPI = true;
        spi_last_error = HAL_OK;
    }
}

void HAL_SPI_RxCpltCallback(SPI_HandleTypeDef *hspi){
	if(hspi->Instance == SPI1){
        rxCompleteSPI = true;
        spi_last_error = HAL_OK;
	}
}

void HAL_SPI_ErrorCallback(SPI_HandleTypeDef *hspi){
    if(hspi->Instance == SPI1){
    	spi_last_error = hspi->ErrorCode;
    	rxCompleteSPI = true;
    	txCompleteSPI = true;
    }
}

/**
  * @brief SPI1 Initialization Function
  * @param None
  * @retval None
  */
HAL_StatusTypeDef SPI_Init(void){

	hspi1.Instance = SPI1;
	hspi1.Init.Mode = SPI_MODE_MASTER;
	hspi1.Init.Direction = SPI_DIRECTION_2LINES;
	hspi1.Init.DataSize = SPI_DATASIZE_8BIT;
	hspi1.Init.CLKPolarity = SPI_POLARITY_LOW;
	hspi1.Init.CLKPhase = SPI_PHASE_1EDGE;
	hspi1.Init.NSS = SPI_NSS_SOFT;
	hspi1.Init.BaudRatePrescaler = SPI_BAUDRATEPRESCALER_2;
	hspi1.Init.FirstBit = SPI_FIRSTBIT_MSB;
	hspi1.Init.TIMode = SPI_TIMODE_DISABLE;
	hspi1.Init.CRCCalculation = SPI_CRCCALCULATION_DISABLE;
	hspi1.Init.CRCPolynomial = 10;
	return HAL_SPI_Init(&hspi1);
}

HAL_StatusTypeDef writeRegisterSPI(
	uint8_t txBuffer,
	uint16_t sizeData
){
	/**
	  * @brief  Transmit an amount of data in non-blocking mode with Interrupt.
	  * @param  hspi pointer to a SPI_HandleTypeDef structure that contains
	  *               the configuration information for SPI module.
	  * @param  pData pointer to data buffer (u8 or u16 data elements)
	  * @param  Size amount of data elements (u8 or u16) to be sent
	  * @retval HAL status
	  */
	return HAL_SPI_Transmit_IT(&hspi1, txBuffer, sizeof(txBuffer) - 1);
}

