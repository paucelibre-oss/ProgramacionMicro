#include "i2c.h"

I2C_HandleTypeDef hi2c1;

#define MAX_WAIT_RESPONSEI2C	30
#define MAX_TIMEOUT_DEVREADY	100
#define NUMBERS_OF_TRIALS		3

static volatile bool txCompleteI2C = false;
static volatile bool rxCompleteI2C = false;

/* helpers */
void clearFlagTxI2C(void){ txCompleteI2C = false; }
void clearFlagRxI2C(void){ rxCompleteI2C = false; }
bool getRxFlagStatusI2C(void){ return rxCompleteI2C; }
bool getTxFlagStatusI2C(void){ return txCompleteI2C; }

void HAL_I2C_MemRxCpltCallback(I2C_HandleTypeDef *hi2c){
    if (hi2c->Instance == I2C1) {
        rxCompleteI2C = true;
    }
}

void HAL_I2C_MemTxCpltCallback(I2C_HandleTypeDef *hi2c){
    if (hi2c->Instance == I2C1) {
        txCompleteI2C = true;
    }
}

/**
  * @brief I2C1 Initialization Function
  * @param None
  * @retval None
  */
HAL_StatusTypeDef I2C_Init(void){

  hi2c1.Instance = I2C1;
  hi2c1.Init.ClockSpeed = 100000;
  hi2c1.Init.DutyCycle = I2C_DUTYCYCLE_2;
  hi2c1.Init.OwnAddress1 = 0;
  hi2c1.Init.AddressingMode = I2C_ADDRESSINGMODE_7BIT;
  hi2c1.Init.DualAddressMode = I2C_DUALADDRESS_DISABLE;
  hi2c1.Init.OwnAddress2 = 0;
  hi2c1.Init.GeneralCallMode = I2C_GENERALCALL_DISABLE;
  hi2c1.Init.NoStretchMode = I2C_NOSTRETCH_DISABLE;

  return HAL_I2C_Init(&hi2c1);
}

HAL_StatusTypeDef readRegisterI2C_IT(
	uint8_t dev7bit,
	uint8_t regAddr,
	uint8_t* rxBuffer,
	uint16_t rxLength
){
    uint16_t dev = I2C_ADDR_7BITS_TO_HAL(dev7bit);

    clearFlagRxI2C();

    if(HAL_I2C_IsDeviceReady(&hi2c1, dev, (uint32_t)(NUMBERS_OF_TRIALS), MAX_TIMEOUT_DEVREADY) != HAL_OK)  return HAL_ERROR;
    return HAL_I2C_Mem_Read_IT(&hi2c1, dev, regAddr, I2C_MEMADD_SIZE_8BIT, rxBuffer, rxLength);
}

HAL_StatusTypeDef writeRegisterI2C_IT(
	uint8_t dev7bit,
	uint8_t regAddr,
	uint8_t* data,
	uint16_t lenData
){
    uint16_t dev = I2C_ADDR_7BITS_TO_HAL(dev7bit);

    clearFlagTxI2C();

    if (HAL_I2C_IsDeviceReady(&hi2c1, dev, (uint32_t)(NUMBERS_OF_TRIALS), MAX_TIMEOUT_DEVREADY) != HAL_OK)  return HAL_ERROR;

    return HAL_I2C_Mem_Write_IT(&hi2c1, dev, regAddr, I2C_MEMADD_SIZE_8BIT, data, lenData);
}

HAL_StatusTypeDef readRegisterI2C(
	uint8_t dev7bit,
	uint8_t regAddr,
	uint8_t* rxBuffer,
	uint16_t rxLength
){
	uint16_t dev = I2C_ADDR_7BITS_TO_HAL(dev7bit);

	if (HAL_I2C_IsDeviceReady(&hi2c1, dev, (uint32_t)(NUMBERS_OF_TRIALS), MAX_TIMEOUT_DEVREADY) != HAL_OK)  return HAL_ERROR;

	return HAL_I2C_Master_Receive(&hi2c1, dev, rxBuffer, rxLength, (uint32_t)(MAX_WAIT_RESPONSEI2C));
}

HAL_StatusTypeDef writeRegisterI2C(
	uint8_t dev7bit,
	uint8_t regAddr,
	uint8_t* data,
	uint16_t lenData
){
	uint16_t dev = I2C_ADDR_7BITS_TO_HAL(dev7bit);

	if (HAL_I2C_IsDeviceReady(&hi2c1, dev, (uint32_t)(NUMBERS_OF_TRIALS), MAX_TIMEOUT_DEVREADY) != HAL_OK)  return HAL_ERROR;

	return HAL_I2C_Master_Transmit(&hi2c1, dev, data, lenData, (uint32_t)(MAX_WAIT_RESPONSEI2C));
}

