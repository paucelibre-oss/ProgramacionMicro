#include "myApp_GPIO.h"

static void actionPin(GPIO_TypeDef* GPIOx, uint16_t GPIO_Pi, _gpioState state);

/*
 * Function Name: gpioInit
 * Function Description: Initialize the GPIO ports.
 * Input Parameters: None.
 * Return value: None.
 */
void gpioInit(void){
	GPIO_Init();
}

/*
 * Function Name: nfcSS
 * Function Description: Pull the CSS pin of the MRFC522 high or low.
 * Input Parameters: _gpioState state. TURN_ON for High or TURN_OFF for low.
 * Return value: None.
 */
void nfcSS(
	_gpioState state
){
	actionPin(SPI3_CS_GPIO_Port, SPI3_CS_Pin, state);
}

/*
 * Function Name: nfcRST
 * Function Description: Pull the RST pin of the MRFC522 high or low.
 * Input Parameters: _gpioState state. TURN_ON for High or TURN_OFF for low.
 * Return value: None.
 */
void nfcRST(
	_gpioState state
){
	actionPin(RST_PN532_GPIO_Port, RST_PN532_Pin, state);
}

/*
 * Function Name: actionPin
 * Function Description: Put a selected pin high or low.
 * Input Parameters: GPIO_TypeDef* GPIOx - Port of the pin, uint16_t GPIO_Pin - The pin number. _gpioState state - the state of pin.
 * Return value: None.
 */
static void actionPin(
	GPIO_TypeDef* GPIOx,
	uint16_t GPIO_Pin,
	_gpioState state
){

	if(state == TURN_ON){
		GPIO_Set(GPIOx, GPIO_Pin);
		return;
	}

	if(state == TURN_OFF){
		GPIO_Reset(GPIOx, GPIO_Pin);
		return;
	}

}

/*
 * Function Name: ledOff
 * Function Description: Turn off LED2 on the NUCLEO-F446RE board.
 * Input Parameters: None.
 * Return value: None.
 */
void ledOff(void){
	actionPin(LED_GPIO_Port, LED_Pin, TURN_OFF);
}

/*
 * Function Name: ledToggleNonBlocking
 * Function Description: Toggles the state of the LED2 pin. Non-blocking method.
 * Input Parameters: uint32_t interval - Delays in ms between alternation.
 * Return value: None.
 */
void ledToggleNonBlocking(uint32_t interval){

    static uint32_t lastToggle = 0;
    static GPIO_PinState led_state = GPIO_PIN_RESET;

    if (HAL_GetTick() - lastToggle >= interval){
        lastToggle = HAL_GetTick();
        led_state = (led_state == GPIO_PIN_RESET) ? GPIO_PIN_SET : GPIO_PIN_RESET;
        HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, led_state);
    }
}


