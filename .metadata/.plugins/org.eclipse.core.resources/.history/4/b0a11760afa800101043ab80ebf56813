#include "PN532.h"

static void PN532_WriteCommand(uint8_t *cmd, uint8_t cmdlen);
static bool PN532_ReadResponse(uint8_t *buf, uint8_t len);
static bool PN532_WaitReady(uint32_t timeout);
static void PN532_SendAck(void);

// ACK frame para PN532
static const uint8_t pn532_ack_frame[] = {0x00, 0x00, 0xFF, 0x00, 0xFF, 0x00};

// === Inicialización básica ===
void PN532_Init(void)
{
    HAL_Delay(100);
}

// === Obtener versión de firmware ===
bool PN532_GetFirmwareVersion(uint8_t *ic, uint8_t *ver, uint8_t *rev, uint8_t *support)
{
    uint8_t cmd[] = {PN532_COMMAND_GETFIRMWAREVERSION};
    PN532_WriteCommand(cmd, 1);

    if (!PN532_WaitReady(100)) return false;

    uint8_t resp[12] = {0};
    if (!PN532_ReadResponse(resp, sizeof(resp))) return false;

    // Esperamos respuesta tipo D5 03 <IC> <Ver> <Rev> <Support>
    if (resp[0] != 0xD5 || resp[1] != 0x03) return false;

    *ic      = resp[2];
    *ver     = resp[3];
    *rev     = resp[4];
    *support = resp[5];
    return true;
}

// === Espera hasta que el PN532 esté listo ===
static bool PN532_WaitReady(uint32_t timeout)
{
    uint8_t status = 0;
    uint32_t start = HAL_GetTick();

    while ((HAL_GetTick() - start) < timeout)
    {
        HAL_GPIO_WritePin(CS_GPIO_Port, CS_Pin, GPIO_PIN_RESET);
        uint8_t cmd = PN532_SPI_STATREAD;
        HAL_SPI_Transmit(&hspi1, &cmd, 1, HAL_MAX_DELAY);
        HAL_SPI_Receive(&hspi1, &status, 1, HAL_MAX_DELAY);
        HAL_GPIO_WritePin(CS_GPIO_Port, CS_Pin, GPIO_PIN_SET);

        if (status == PN532_SPI_READY)
            return true;

        HAL_Delay(5);
    }
    return false;
}

// === Envío de un comando al PN532 ===
static void PN532_WriteCommand(uint8_t *cmd, uint8_t cmdlen)
{
    uint8_t frame[32];
    uint8_t length = cmdlen + 1;  // +1 por TFI
    uint8_t lcs = (uint8_t)(~length + 1);
    uint8_t checksum = PN532_HOSTTOPN532;

    uint8_t idx = 0;
    frame[idx++] = PN532_SPI_DATAWRITE;
    frame[idx++] = PN532_PREAMBLE;
    frame[idx++] = PN532_STARTCODE1;
    frame[idx++] = PN532_STARTCODE2;
    frame[idx++] = length;
    frame[idx++] = lcs;
    frame[idx++] = PN532_HOSTTOPN532;

    for (uint8_t i = 0; i < cmdlen; i++)
    {
        frame[idx++] = cmd[i];
        checksum += cmd[i];
    }

    frame[idx++] = (uint8_t)(~checksum + 1);
    frame[idx++] = PN532_POSTAMBLE;

    HAL_GPIO_WritePin(CS_GPIO_Port, CS_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi1, frame, idx, HAL_MAX_DELAY);
    HAL_GPIO_WritePin(CS_GPIO_Port, CS_Pin, GPIO_PIN_SET);

    // Esperar ACK
    if (!PN532_WaitReady(50)) return;
    uint8_t ack[6] = {0};
    PN532_ReadResponse(ack, 6);
}

// === Leer respuesta desde PN532 ===
static bool PN532_ReadResponse(uint8_t *buf, uint8_t len)
{
    HAL_GPIO_WritePin(CS_GPIO_Port, CS_Pin, GPIO_PIN_RESET);

    uint8_t cmd = PN532_SPI_DATAREAD;
    HAL_SPI_Transmit(&hspi1, &cmd, 1, HAL_MAX_DELAY);
    HAL_SPI_Receive(&hspi1, buf, len, HAL_MAX_DELAY);

    HAL_GPIO_WritePin(CS_GPIO_Port, CS_Pin, GPIO_PIN_SET);
    return true;
}


