// Delays
#define PN532_CMD_DELAY_MS 2
#define PN532_TIMEOUT_MS   1000


/* Transmitir y recibir con toggling CS */
static HAL_StatusTypeDef spi_transfer(uint8_t *tx, uint8_t *rx, uint16_t len, uint32_t timeout) {
    nfcSS(TURN_OFF);
    HAL_Delay(1);
    HAL_StatusTypeDef st = HAL_SPI_TransmitReceive(&hspi3, tx, rx, len, timeout);
    nfcSS(TURN_ON);
    HAL_Delay(1);
    return st;
}

/* Enviar solo (transmit) con CS */
static HAL_StatusTypeDef spi_write(uint8_t *tx, uint16_t len, uint32_t timeout) {
    nfcSS(TURN_OFF); HAL_Delay(1);
    HAL_StatusTypeDef st = HAL_SPI_Transmit(&hspi3, tx, len, timeout);
    nfcSS(TURN_ON);
    HAL_Delay(1);
    return st;
}

/* Leer solo (transmit dummy 0x00) */
static HAL_StatusTypeDef spi_read(uint8_t *rx, uint16_t len, uint32_t timeout) {

uint8_t dummy[len];
    memset(dummy, 0x00, len);

	nfcSS(TURN_OFF);
    HAL_Delay(1);
    HAL_StatusTypeDef st = HAL_SPI_TransmitReceive(&hspi3, dummy, rx, len, timeout);
    nfcSS(TURN_ON);
    HAL_Delay(1);
    return st;
}

/* Calculo simple de LCS y DCS */
static uint8_t calc_lcs(uint8_t len) { return (uint8_t)(~len + 1); }
static uint8_t calc_dcs(uint8_t *data, uint8_t len) {
    uint8_t sum = 0;
    for (uint8_t i=0;i<len;i++) sum += data[i];
    return (uint8_t)(~sum + 1);
}

/* Construir y enviar frame de comando (host->PN532) */
HAL_StatusTypeDef PN532_SendCommand(uint8_t *payload, uint8_t payload_len) {
    uint8_t pb[8 + payload_len];
    uint8_t idx = 0;
    // preamble/start
    pb[idx++] = 0x00;
    pb[idx++] = 0x00;
    pb[idx++] = 0xFF;
    // LEN and LCS
    uint8_t LEN = payload_len;
    pb[idx++] = LEN;
    pb[idx++] = calc_lcs(LEN);
    // payload (TFI + data)
    uint8_t dcs = calc_dcs(payload, payload_len);
    for (uint8_t i=0;i<payload_len;i++) pb[idx++] = payload[i];
    pb[idx++] = dcs;
    pb[idx++] = 0x00; // postamble
    return spi_write(pb, idx, PN532_TIMEOUT_MS);
}

/* Esperar ACK fijo: 00 00 FF 00 FF 00 */
static int PN532_ReceiveAck(uint32_t timeout_ms) {
    uint8_t ack_expected[6] = {0x00,0x00,0xFF,0x00,0xFF,0x00};
    uint8_t rx[6];
    uint32_t t0 = HAL_GetTick();
    while (HAL_GetTick() - t0 < timeout_ms) {
        // En SPI antes de leer la respuesta es recomendable leer el "status" y comprobar RDY.
        // Implementación simple: intentar leer 6 bytes (envía dummy 0x00s para leer)
        if (spi_read(rx, 6, 100) == HAL_OK) {
            if (memcmp(rx, ack_expected, 6) == 0) return 1; // ACK recibido
        }
        HAL_Delay(5);
    }
    return 0; // timeout / no ack
}

/* Leer respuesta completa (asumiendo que hay framing) */
static int PN532_ReadResponse(uint8_t *out_buf, uint16_t max_len, uint32_t timeout_ms) {
    // Leer header inicial suficiente para parsear LEN -> luego leer resto.
    uint8_t header[6];
    uint32_t t0 = HAL_GetTick();
    while (HAL_GetTick() - t0 < timeout_ms) {
        if (spi_read(header, 6, 100) == HAL_OK) {
            // buscar 0x00 0x00 0xFF en header
            if (header[0]==0x00 && header[1]==0x00 && header[2]==0xFF) {
                uint8_t LEN = header[3];
                // leh
                uint8_t LCS = header[4];
                if ((uint8_t)(LEN + LCS) != 0x00) return 0; // error
                // leer LEN + DCS + POSTAMBLE
                uint16_t remaining = LEN + 2; // LEN bytes payload + DCS + postamble
                if (remaining > max_len) return 0;
                if (spi_read(out_buf, remaining, 500) != HAL_OK) return 0;
                return LEN; // retorna cantidad de bytes de payload recibidos
            }
        }
        HAL_Delay(5);
    }
    return 0;
}

