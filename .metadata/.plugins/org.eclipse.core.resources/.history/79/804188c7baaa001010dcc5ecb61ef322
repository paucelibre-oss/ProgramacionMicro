#include "myApp_PCcom.h"

#define RX_BUFFER_SIZE 64

/*Variable that stores the threshold parameter received by UART*/
static uint8_t paramCommand[RX_BUFFER_SIZE];
/*UART receive buffer*/
static uint8_t rxBuffer[RX_BUFFER_SIZE];
/*Index of the buffer reception UART*/
volatile size_t rxIndex = 0;
/*UART reception state variable*/
static volatile _uartErrors uartRxBusy = UART_ERROR_WAIT_COMMAND;
/*Incoming byte via UART*/
static uint8_t rxByte = 0;

/*Variable containing errors and printable messages*/
static const char *messagesError[UART_ERROR_COUNT] = {
	"\r\n[myApp_PCcom] UART ok.",
	"\r\n[myApp_PCcom] UART waiting command.",
	"\r\n[myApp_PCcom] The pointer to the string is null!",
	"\r\n[myApp_PCcom] The size must be greater than or equal to 1!",
	"\r\n[myApp_PCcom] ERROR: The UART is busy!",
	"\r\n[myApp_PCcom] ERROR: The data reception was not OK"
};

/*List of commands received by UART*/
static const char *commands[PC_COMMAND_COUNT] = {
	"NONE",
	"RESET",
	"STATUS",
	"THRESHOLD"
};

/*Static methods.*/
static size_t uartGetData(uint8_t * pstring, uint16_t lenPstring, _uartErrors* error);
static _uartErrors initReceive(void);
static _commandPC reviewCommand(uint8_t* command);
static bool strEqualsIgnoreCase(const char *s1, const char *s2);

/*
 * Function Name:getParameter
 * Function Description: Returns the parameter identified incoming by UART.
 * Input Parameters: None.
 * Return value: A pointer of paramCommand.
 */
uint8_t* getParameter(void){ return paramCommand; }

/*
 * Function Name: HAL_UART_RxCpltCallback
 * Function Description: UART peripheral callback function.
 * Input Parameters: UART_HandleTypeDef *huart - UART peripheral number.
 * Return value: None.
 */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart){
	if(huart == NULL) return;
    if (huart->Instance == USART2) {
    	if(rxByte == '\r' || rxByte == '\n'){
    		if(rxIndex < RX_BUFFER_SIZE) rxBuffer[rxIndex] = '\0';
    		else rxBuffer[RX_BUFFER_SIZE-1] = '\0';
    		uartRxBusy = UART_ERROR_OK;
    		rxIndex = 0;
    	}else{
    		if(rxIndex < RX_BUFFER_SIZE - 1) {
    			rxBuffer[rxIndex++] = rxByte;
    		}
    	}

    	if(HAL_UART_Receive_IT(&huart2, &rxByte, 1) != HAL_OK) uartRxBusy = UART_ERROR_RECEIVE;
    }
}

/*
 * Function Name:
 * Function Description:
 * Input Parameters:
 * Return value:
 */
bool uartInit(void){

	if(UART_Init() != HAL_OK) return false;
	uartSendString((uint8_t*)("\033[2J\033[H"));

    if(HAL_UART_Receive_IT(&huart2, &rxByte, 1) != HAL_OK){
        uartSendString((uint8_t *)(messagesError[UART_ERROR_RECEIVE]));
        uartRxBusy = UART_ERROR_RECEIVE;
        return false;
    } else {
        uartRxBusy = UART_ERROR_BUSY;
    }
    return true;
}

/*
 * Function Name:
 * Function Description:
 * Input Parameters:
 * Return value:
 */
static _uartErrors initReceive(void){
	if(HAL_UART_Receive_IT(&huart2, &rxByte, 1) != HAL_OK){
		uartSendString((uint8_t *)(messagesError[UART_ERROR_RECEIVE]));
		return UART_ERROR_RECEIVE;
	}

	return UART_ERROR_BUSY;
}

/*
 * Function Name:
 * Function Description:
 * Input Parameters:
 * Return value:
 */
void uartSendString(
	uint8_t * pstring
){
	if(pstring == NULL){
		HAL_UART_Transmit(&huart2, (uint8_t*)(messagesError[UART_ERROR_STRING_NULL]), strlen(messagesError[UART_ERROR_STRING_NULL]), HAL_MAX_DELAY);
		return;
	}
	HAL_UART_Transmit(&huart2, pstring, strlen((const char*)(pstring)), HAL_MAX_DELAY);
}

/*
 * Function Name:
 * Function Description:
 * Input Parameters:
 * Return value:
 */
void uartSendStringSize(
	uint8_t * pstring,
	uint16_t size
){
	if(pstring == NULL){
		HAL_UART_Transmit(&huart2, (uint8_t*)(messagesError[UART_ERROR_STRING_NULL]), strlen(messagesError[UART_ERROR_STRING_NULL]), HAL_MAX_DELAY);
		return;
	}
	if(size <= 0){
		HAL_UART_Transmit(&huart2, (uint8_t*)(messagesError[UART_ERROR_SIZE_ZERO]), strlen(messagesError[UART_ERROR_SIZE_ZERO]), HAL_MAX_DELAY);
		return;
	}
	HAL_UART_Transmit(&huart2, pstring, size, HAL_MAX_DELAY);
}

/*
 * Function Name:
 * Function Description:
 * Input Parameters:
 * Return value:
 */
_commandPC getCommand(void){

	_uartErrors error;
	_commandPC commandId = PC_COMMAND_NONE;
	uint8_t msj[RX_BUFFER_SIZE] = {0};

	size_t size = uartGetData(msj, sizeof(msj)-1, &error);
	if(error != UART_ERROR_OK) return PC_COMMAND_NONE;
	if(size > 0){
		if(size >= sizeof(msj)) size = sizeof(msj)-1;
		msj[size] = '\0';
		commandId = reviewCommand(msj);
	}

	return commandId;
}

/*
 * Function Name:
 * Function Description:
 * Input Parameters:
 * Return value:
 */
static size_t uartGetData(
	uint8_t * pstring,
	uint16_t lenPstring,
	_uartErrors* error
){
	if(uartRxBusy == UART_ERROR_RECEIVE){
		memset(rxBuffer, 0x00, sizeof(rxBuffer));
		rxIndex = 0;
		uartRxBusy = initReceive();
		(*error) = uartRxBusy;
		return 0;
	}

	if(uartRxBusy != UART_ERROR_OK){
		(*error) = uartRxBusy;
		return 0;
	}

	if(pstring == NULL){
		HAL_UART_Transmit(&huart2, (uint8_t*)(messagesError[UART_ERROR_STRING_NULL]), strlen(messagesError[UART_ERROR_STRING_NULL]), HAL_MAX_DELAY);
		return 0;
	}

	size_t len = strlen((char*)(rxBuffer));
	memset(pstring, 0x00, lenPstring);
	memcpy(pstring, rxBuffer, len);

	uartRxBusy = UART_ERROR_BUSY;
	(*error) = UART_ERROR_OK;
	return len;
}

/*
 * Function Name:
 * Function Description:
 * Input Parameters:
 * Return value:
 */
static _commandPC reviewCommand(
	uint8_t* command
){

	char cmd[32] = {0};
	memset(paramCommand, 0x00, sizeof(paramCommand));

	if(command == NULL) return PC_COMMAND_NONE;

	char *sep = strchr((char*)(command), ':');
	if (sep != NULL) {
	    size_t cmd_len = sep - (char*)(command);
	    if (cmd_len >= sizeof(cmd)) cmd_len = sizeof(cmd)-1;
	    strncpy(cmd, (char*)(command), cmd_len);
	    cmd[cmd_len] = '\0';
	    strncpy((char*)paramCommand, sep + 1, sizeof(paramCommand)-1);
	    paramCommand[sizeof(paramCommand) - 1] = '\0';
	} else {
        strncpy(cmd, (char*)(command), sizeof(cmd)-1);
        cmd[sizeof(cmd)-1] = '\0';
	}

    size_t len = strlen(cmd);
    while (len > 0 && (cmd[len-1] == '\r' || cmd[len-1] == '\n' || cmd[len-1] == ' '))
    cmd[--len] = '\0';

    char *start = cmd;
    while (*start == ' ' || *start == '\t') start++;
    if (start != cmd) memmove(cmd, start, strlen(start) + 1);

	if(strEqualsIgnoreCase(cmd, commands[PC_COMMAND_RST])) return PC_COMMAND_RST;
	if(strEqualsIgnoreCase(cmd, commands[PC_COMMAND_STATUS])) return PC_COMMAND_STATUS;
	if(strEqualsIgnoreCase(cmd, commands[PC_COMMAND_THRESHOLD])) return PC_COMMAND_THRESHOLD;

	return PC_COMMAND_UNKNOWN_COMMAND;

}

/*
 * Function Name:
 * Function Description:
 * Input Parameters:
 * Return value:
 */
/* compara dos strings sin importar mayusculas/minusculas */
static bool strEqualsIgnoreCase(
	const char *s1,
	const char *s2
){
	if(s1 == NULL || s2 == NULL) return false;

    while (*s1 && *s2) {
    	if (tolower((unsigned char)*s1) != tolower((unsigned char)*s2)) return false;

        s1++;
        s2++;
    }
    return *s1 == '\0' && *s2 == '\0';
}

