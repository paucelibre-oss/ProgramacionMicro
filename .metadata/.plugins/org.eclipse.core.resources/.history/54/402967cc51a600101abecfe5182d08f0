#include "gpio.h"

void gpioInit(void){
	GPIO_Init();
}

void nfcSS(
	_gpioState state
){

	if(state == TURN_ON){
		GPIO_Set(SS_GPIO_Port, SS_Pin);
		return;
	}

	if(state == TURN_OFF){
		GPIO_Reset(SS_GPIO_Port, SS_Pin);
		return;
	}
}

